    "@sailshq/socket.io-redis": "^6.1.2",
    "inertia-sails": "^1.6.0",
    "nodemailer": "^10.0.3",
    "sails": "^1.5.18",
    "sails-flash": "^0.0.1",
    "sails-hook-mail": "^0.1.0",
    "sails-hook-organics": "^3.0.1",
    "sails-hook-orm": "^4.0.3",
    "sails-hook-sockets": "^3.0.2",
    "sails-hook-wish": "^1.1.0",
    "svelte": "^5.57.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@rsbuild/plugin-svelte": "^2.0.1",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "@types/node": "^22.20.2",
    "create-sails-generator": "^1.0.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "rsbuild-plugin-inertia": "^0.0.1",
    "sails-hook-dev": "^1.3.0",
    "sails-hook-shipwright": "^1.5.1",
