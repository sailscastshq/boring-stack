    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "inertia-sails": "^1.6.0",
    "nodemailer": "^10.0.3",
    "qrcode": "^1.5.4",
    "sails": "^1.5.18",
    "sails-content": "^0.1.0",
    "sails-flash": "^0.0.1",
    "sails-hook-clearance": "^0.0.1",
    "sails-hook-content": "^0.0.11",
    "sails-hook-mail": "^0.2.2",
    "sails-hook-organics": "^3.0.1",
    "sails-hook-orm": "^4.0.3",
    "sails-hook-sockets": "^3.0.2",
    "sails-hook-uploads": "^0.4.3",
    "sails-hook-wish": "^1.1.0",
    "sails-pay": "^0.0.5",
    "sails-sqlite": "^0.2.6",
    "skipper-s3": "^0.6.0",
    "speakeasy": "^2.0.0",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "@rsbuild/plugin-vue": "^2.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "create-sails-generator": "^1.0.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "rsbuild-plugin-inertia": "^0.0.1",
    "sails-hook-shipwright": "^1.5.1",
    "sails.io.js": "^1.2.1",
    "socket.io-client": "^4.8.3",
    "sounding": "^0.0.1",
    "tailwindcss": "^4.3.3"
  },
  "scripts": {
    "dev": "node --watch-path=api --watch-path=config app.js",
    "start": "NODE_ENV=production node app.js",
    "lint": "prettier --check .",
    "lint:fix": "prettier --write .",
    "test:unit": "node --test --test-concurrency=1 tests/unit/**/*.test.js",
    "test:functional": "node --test --test-concurrency=1 tests/functional/**/*.test.js",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/**/*.test.js",
    "test": "npm run test:unit && npm run test:functional && npm run test:e2e"
  },
  "main": "app.js",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "overrides": {
    "qs": "^6.16.0",
    "body-parser@1": "^1.20.6",
    "skipper-s3": {
      "aws-sdk": "^2.1693.0"
    }
  }
}
