{
  "name": "ascent-vue",
  "version": "0.0.0",
  "private": true,
  "description": "The ultimate free Vue SaaS template for full-stack JavaScript applications",
  "keywords": [
    "saas",
    "vue",
    "sails",
    "template",
    "full-stack",
    "javascript"
  ],
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
