    "@sailshq/socket.io-redis": "^6.1.2",
    "inertia-sails": "^1.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sails": "^1.5.18",
    "sails-flash": "^0.0.1",
    "sails-hook-mail": "^0.2.2",
    "sails-hook-organics": "^3.0.1",
    "sails-hook-orm": "^4.0.3",
    "sails-hook-sockets": "^3.0.2",
    "sails-hook-wish": "^1.1.0",
    "tailwind-merge": "^3.6.0",
    "nodemailer": "^10.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "create-sails-generator": "^1.0.0",
    "playwright": "^1.63.0",
    "prettier": "^2.8.8",
    "prettier-plugin-tailwindcss": "^0.4.1",
    "rsbuild-plugin-inertia": "^0.0.1",
